{#- 홈 하단: 최근 글 목록 + 이번주의 랜덤 글 (둘 다 빌드 시 노트에서 자동 생성) -#}
<section class="home-recent">
  <h2>최근 글</h2>
  <ul class="home-recent-list">
    {%- for note in userComputed.recentNotes %}
    <li>
      <span class="home-recent-date">{{ note.dateLabel }}</span>
      <a href="{{ note.permalink }}">{{ note.name }}</a>
      <span class="home-recent-folder">{{ note.folder }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>

<section class="home-random">
  {#- 제목 자체가 링크: 클릭하면 이번 주 랜덤 글로 이동 -#}
  <h2><a id="home-random-link" href="#">이번주의 랜덤 글 →</a></h2>
</section>
<script>
  (function () {
    var pool = {{ userComputed.randomPoolJson | safe }};
    var link = document.getElementById("home-random-link");
    if (!link || !pool.length) return;

    // 월요일 0시(방문자 로컬 시간) 기준 주차 번호. 1970-01-01이 목요일이라 +3.
    var now = new Date();
    var localDays = Math.floor((now.getTime() - now.getTimezoneOffset() * 60000) / 86400000);
    var week = Math.floor((localDays + 3) / 7);

    // mulberry32: 같은 주면 누가 봐도 같은 글이 나오도록 시드 고정
    var t = (week + 0x6d2b79f5) | 0;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    var rand = ((t ^ (t >>> 14)) >>> 0) / 4294967296;

    var pick = pool[Math.floor(rand * pool.length)];
    link.setAttribute("href", pick[1]);
    link.setAttribute("title", pick[0]);
  })();
</script>
